	"authors": [
		"a6a.dr"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/miao/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"a6a.dr.Miao"
		]
	},
	"mixins": [
		"miao.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
